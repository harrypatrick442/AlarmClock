<UserControl x:Class="AlarmClock.Display.LedSegment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             SnapsToDevicePixels="True">
    <Grid>
        <!-- We draw a polygon-like segment using a Path -->
        <Path x:Name="SegmentPath"
              Stretch="None"
              StrokeThickness="0"
              Fill="{Binding OffBrush, ElementName=root}">
            <Path.Effect>
                <!-- Soft glow only when lit (we’ll toggle it in code-behind) -->
                <DropShadowEffect x:Name="Glow"
                                  ShadowDepth="0"
                                  BlurRadius="18"
                                  Opacity="0"
                                  Color="#00FFFFFF"/>
            </Path.Effect>
        </Path>
    </Grid>
</UserControl>