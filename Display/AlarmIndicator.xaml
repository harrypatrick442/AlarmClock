<UserControl x:Class="AlarmClock.Display.AlarmIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             Width="50" Height="60"
             SnapsToDevicePixels="True">

    <Grid>
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Grid Width="32" Height="32" Margin="0,0,0,4">
                <!-- Bell icon -->
                <Canvas Width="24" Height="24">
                    <Path x:Name="BellShape"
                          Data="M12,2 C13.1,2 14,2.9 14,4 C14,4.55 13.78,5.05 13.4,5.4 C16.01,6.26 18,8.92 18,12 V17 L20,19 V20 H4 V19 L6,17 V12 C6,8.92 7.99,6.26 10.6,5.4 C10.22,5.05 10,4.55 10,4 C10,2.9 10.9,2 12,2 Z M12,22 C10.9,22 10,21.1 10,20 H14 C14,21.1 13.1,22 12,22 Z"
                          Fill="{Binding OffBrush, ElementName=root}">
                        <Path.Effect>
                            <DropShadowEffect x:Name="Glow" ShadowDepth="0" BlurRadius="18" Opacity="0"/>
                        </Path.Effect>
                    </Path>
                </Canvas>

                <!-- Cross overlay -->
                <Canvas Width="24" Height="24">
                    <Line x:Name="Cross1" X1="4" Y1="4" X2="20" Y2="20"
                          Stroke="{Binding OnBrush, ElementName=root}"
                          StrokeThickness="3" Visibility="Collapsed"/>
                    <Line x:Name="Cross2" X1="20" Y1="4" X2="4" Y2="20"
                          Stroke="{Binding OnBrush, ElementName=root}"
                          StrokeThickness="3" Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <!-- Number -->
            <TextBlock x:Name="NumberLabel"
                       Text="{Binding Number, ElementName=root}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{Binding OffBrush, ElementName=root}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
